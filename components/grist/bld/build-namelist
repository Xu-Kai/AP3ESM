sub fv3_decomp_set{
# Return a decomposition for the FV3 dycore, expressed as the value for the namelist
# variable layout.  The value of layout is nx,ny where nx and ny are
# respecitively the number of x, y, subdomains of an FV3 tile in the multi-2D decomposition.
# The following constraints must be observed:
# 1) nx*ny*6 = ntasks (nx*ny*6 must be equal to ntasks.  fv3 can handle other cases but for
#                     now this decomp routine requires that constraint.
#                     Assume the user will set the
#                     decomp explicitly if that is what is desired.)
# 2) tilesizex/nx >=4 decomp must allow for a minimum of 4 elements in a x direction task
# 3) tilesizey/ny >=4 decomp must allow for a minimum of 4 elements in a y direction task
# 4) tilesizex%nx =0  decomp requires that tile points in x direction must divide evenly by nx
# 5) tilesizey%ny =0  decomp requires that tile points in y direction must divide evenly by ny
#
# The strategy for setting the default decomposition is to use a decomposition with approximately
# equal nx and ny values

    my $tasks = $opts{'ntasks'};
    my $xpts = $nl->get_value('fv3_npx') - 1;
    my $ypts = $nl->get_value('fv3_npy') - 1;
    my $nx;
    my $ny;
    my $aspect = $xpts;
    my $layoutx = 0;
    my $layouty = 0;

    # die if bad input
    if ($tasks < 1) {
        die "$ProgName - ERROR: fv3_decomp_set: bad input: ntasks=$tasks.\n" .
            "  -ntask argument to build-namelist is wrong.";
    }

  NZ: for ($nx = 1; $nx <= int $xpts/4; ++$nx) {

      # test that $nx divides $xpts evenly
      if ($xpts%$nx == 0) {
	  $ny = int $tasks/$nx/6;
	  # test that $ny divides $ypts exactly
	  # if so then get aspect ratio
	  if ($ny != 0) {
	      if ($ypts%$ny == 0 and  $nx*$ny*6 == $tasks) {
		  if ($nx == $ny) {
		      $layoutx=$nx;
		      $layouty=$ny;
		      last NZ;
		  }else{
		      if (max($nx,$ny) / min($nx,$ny) < $aspect) {
			  $aspect=max($nx,$ny) / min($nx,$ny);
			  $layoutx=$nx;
			  $layouty=$ny;
		      }
		  }
	      }
	  }
      }
    }
    # die if algorithm failed
    if ($layoutx > $xpts/4 or $layouty > $ypts/4  or  $layoutx*$layouty*6 != $tasks) {
        die "$ProgName - ERROR: fv3_decomp_set failed to find a decomposition.\n" .
            "  layout needs to be set by the user.";
    }

    return "$layoutx,$layouty";

}

