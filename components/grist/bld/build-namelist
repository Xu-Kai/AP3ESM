sub check_snapshot_settings {

    # This checks the snapshot settings

    my $cam_take_snapshot_before = $nl->get_variable_value('phys_ctl_nl', 'cam_take_snapshot_before');
    my $cam_take_snapshot_after  = $nl->get_variable_value('phys_ctl_nl', 'cam_take_snapshot_after');
    my $cam_snapshot_before_num  =  $nl->get_variable_value('phys_ctl_nl', 'cam_snapshot_before_num');
    my $cam_snapshot_after_num   =  $nl->get_variable_value('phys_ctl_nl', 'cam_snapshot_after_num');
    my $microphys = $cfg->get('microphys');

    if (($cam_snapshot_before_num >= 0) or ($cam_snapshot_after_num >= 0)) {
        print  "cam_snapshot settings\n";
        print "cam_take_snapshot_before = $cam_take_snapshot_before\n";
        print "cam_take_snapshot_after  = $cam_take_snapshot_after\n";
        print "cam_snapshot_before_num = $cam_snapshot_before_num\n";
        print "cam_snapshot_after_num  = $cam_snapshot_after_num\n";
    } else {
        return;  # No snapshots are requested
    }

    # Set the empty_htapes always to false for snapshot runs
    $nl->set_variable_value('cam_history_nl', 'empty_htapes', $FALSE);

    # Check for "take_snapshot" and history file number both being set or not set.  Only one set is an error
    if ( ((defined $cam_take_snapshot_before ) xor  (defined $cam_snapshot_before_num))) {
        die "ERROR: cam_take_snapshot_before is set to $cam_take_snapshot_before \n and cam_snapshot_before_num is set to
                      $cam_snapshot_before_num \n Both need to be set or not set";
    }

    if ( ((defined $cam_take_snapshot_after ) xor  (defined $cam_snapshot_after_num))) {
        die "ERROR: cam_take_snapshot_after is set to $cam_take_snapshot_after \n and cam_snapshot_after_num is set to
                      $cam_snapshot_after_num \n Both need to be set or not set";
    }

    # If a snapshot history file number is negative, turn off that snapshot
    if ((defined $cam_snapshot_before_num) and ($cam_snapshot_before_num lt 0)) {
        print "WARNING: No history file assigned to before snapshot, disabling\n";
        $nl->set_variable_value('phys_ctl_nl', 'cam_take_snapshot_before', "'UNSET'");
    }
    if ((defined $cam_snapshot_after_num) and ($cam_snapshot_after_num lt 0)) {
        print "WARNING: No history file assigned to after snapshot, disabling\n";
        $nl->set_variable_value('phys_ctl_nl', 'cam_take_snapshot_after', "'UNSET'");
    }


    # Check for "cam_take_snapshot" values for before and after being compatible
    # Due to the physics call structure, only some before/after pairs are valid
    # After the appropriate check is found, return as no other checks will pertain

    my $user_set_before = ((defined $cam_take_snapshot_before) and
                               ($cam_take_snapshot_before eq "'user_set'"));
    my $user_set_after = ((defined $cam_take_snapshot_after) and
                              ($cam_take_snapshot_after eq "'user_set'"));
    if ($user_set_before and $user_set_after) {
        return; # This is okay, user will set before and after code
    } elsif ($user_set_before and (not defined $cam_take_snapshot_after)) {
        return; # This iis okay, user will set before code only
    } elsif ($user_set_after and (not defined $cam_take_snapshot_before)) {
        return; # This iis okay, user will set after code only
    } # No else, just proceed with list checks
    my @validList_bc = ();
    my @validList_ac = ();
    if ($user_set_before) {
        # We cannot check order so mark all after matches okay.
        push (@validList_ac, ("'user_set'"));
        push (@validList_bc, ("'user_set'"));
    }
    if ($simple_phys) {
        # Simple physpkg
        push (@validList_ac, ("'physics_dme_adjust'"));
        if ($phys eq 'held_suarez') {
            push (@validList_bc, ("'held_suarez_tend'"));
        } elsif ($phys eq 'kessler') {
            push (@validList_bc, ("'kessler_tend'"));
        } elsif ($phys eq 'tj2016') {
            push (@validList_bc, ("'thatcher_jablonowski_precip_tend'"));
        }
        if ($chem ne 'none') {
            push (@validList_bc, ("'chem_timestep_tend'"));
        }
    } else {
        # CAM physpkg
        push(@validList_ac, ("'chem_emissions'",
                             "'aoa_tracers_timestep_tend'",
                             "'co2_cycle_set_ptend'"));
        if ($chem ne 'none') {
            push (@validList_ac, ("'chem_timestep_tend'"));
        }
        push (@validList_ac, ("'vertical_diffusion_section'",
                              "'aero_model_drydep'", "'gw_tend'",
                              "'qbo_relax'", "'iondrag_calc_section'",
                              "'physics_dme_adjust'"));
        push (@validList_bc, ("'dadadj_tend'", "'convect_deep_tend'",
                              "'convect_shallow_tend'"));
        push (@validList_bc, ("'aero_model_wetdep'", "'radiation_tend'"));
    }
    if ($user_set_after) {
        # We cannot check order so mark all before matches okay.
        push (@validList_ac, ("'user_set'"));
        push (@validList_bc, ("'user_set'"));
    }

    my $before_index_bc = first_index($cam_take_snapshot_before, @validList_bc);
    my $after_index_bc = first_index($cam_take_snapshot_after, @validList_bc);
    my $before_index_ac = first_index($cam_take_snapshot_before, @validList_ac);
    my $after_index_ac = first_index($cam_take_snapshot_after, @validList_ac);

    # If before is set, it must be valid
    if ((defined $cam_snapshot_before_num) and
          ($cam_snapshot_before_num ge 0) and
          (defined $cam_take_snapshot_before) and
          (($before_index_ac lt 0) and ($before_index_bc lt 0))) {
        die "ERROR: Invalid cam_take_snapshot_before setting, $cam_take_snapshot_before\n"
    }
    # If after is set, it must be valid
    if ((defined $cam_snapshot_after_num) and
          ($cam_snapshot_after_num ge 0) and
          (defined $cam_take_snapshot_after) and
          (($after_index_ac lt 0) and ($after_index_bc lt 0))) {
        die "ERROR: Invalid cam_take_snapshot_after setting, $cam_take_snapshot_after\n"
    }
    # If at least one of before/after are not set requires no further checking
    if (  (! defined $cam_take_snapshot_before) or
          (! defined $cam_take_snapshot_after)) {
        return;
    }
    # If either before or after is 'user_set', end checks
    if ($user_set_before or $user_set_after) {
        return;
    }

    # Some checks to do if both before and after snapshots are being used
    if ((defined $cam_take_snapshot_before) and
          ($cam_snapshot_before_num ge 0) and
          (defined $cam_take_snapshot_after) and
          ($cam_snapshot_after_num ge 0)) {
        if ($before_index_ac ge 0) {
            if ($after_index_bc ge 0) {
                die "ERROR: before and after snapshots must both be in ",
                  "tphysbc or both be in tphysac\n";
            } elsif ($before_index_ac gt $after_index_ac) {
                die "ERROR: cam_take_snapshot_before is set to ",
                  "$cam_take_snapshot_before\n and cam_take_snapshot_after is ",
                  "set to $cam_take_snapshot_after\n",
                  "This combination is invalid\n";
            }
        } else {
            if ($after_index_ac ge 0) {
                die "ERROR: before and after snapshots must both be in ",
                  "tphysbc or both be in tphysac\n";
            } elsif ($before_index_bc gt $after_index_bc) {
                die "ERROR: cam_take_snapshot_before is set to ",
                  "$cam_take_snapshot_before\n and cam_take_snapshot_after is ",
                  "set to $cam_take_snapshot_after\n",
                  "This combination is invalid\n";
            }
        }
    }
}

