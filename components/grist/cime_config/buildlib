from CIME.buildlib import parse_input
from CIME.build import get_standard_makefile_args

logger = logging.getLogger(__name__)



###############################################################################
def _build_grist(caseroot, libroot, bldroot):
###############################################################################

    # with Case(caseroot, read_only=False) as case:

    #     srcroot = case.get_value("SRCROOT")
    #     #-------------------------------------------------------
    #     # Call cam's buildcpp
    #     #-------------------------------------------------------
    #     testpath = os.path.join(srcroot, "components", "grist")
    #     if os.path.exists(testpath):
    #         srcroot = testpath

    #     cmd = os.path.join(os.path.join(srcroot,
    #                                     "cime_config", "buildcpp"))
    #     logger.info("     ...calling grist buildcpp to set build time options")
    #     try:
    #         mod = imp.load_source("buildcpp", cmd)
    #         grist_cppdefs = mod.buildcpp(case)
    #     except:
    #         raise

    with Case(caseroot, read_only=False) as case:

        casetools = case.get_value("CASETOOLS")
        srcroot = case.get_value("SRCROOT")
        gmake_j = case.get_value("GMAKE_J")
        gmake = case.get_value("GMAKE")
        mach = case.get_value("MACH")
        grist_phys = case.get_value("GRIST_PHYS")

        logger.info("1111111111111111111111111")
        logger.info(caseroot)
        logger.info(libroot)
        logger.info(srcroot)

	srcfile=os.path.join(srcroot, "components", "grist", "src","include","data_check.inc")
        shutil.copy2(srcfile, bldroot)
        #-------------------------------------------------------
        # Filepath is created in caseroot/gristconf by the call
        # to buildcpp - this needs to be copied to bldroot
        #-------------------------------------------------------
        filesrc = os.path.join(caseroot, "Buildconf", "gristconf", "Filepath")
        filedst = os.path.join(bldroot, "Filepath_tmp")
        shutil.copy(filesrc, filedst)

        file_path_handle = open(srcroot + "/components/grist/cime_config/path/Filepath.GCM_AMIPW")
        file_tmp_handle = open(filedst, 'w')

        usr_src = os.path.join(caseroot, "SourceMods/src.grist")
        file_tmp_handle.write(usr_src+"\n")
        file_tmp_handle.write(srcroot + "/components/grist/src/cpl"+"\n")
        for file_path in  file_path_handle.readlines():
            # logger.info(file_path)
            full_path = srcroot + "/components/grist/" + file_path
            logger.info(full_path)
            file_tmp_handle.write(full_path)

        file_path_handle.close()
        file_tmp_handle.close()

#         .PHONY:.DEFAULT
# .DEFAULT:
#         +if [ "$(CLEAN)" != "Y" ]; then \
#                 mkdir -p $(BLD); \
#                 cp Makefile.sub $(BLD)/Makefile && \
#                 cp path/Filepath.$(MODEL) $(BLD)/Filepath && \
#                 cp Macros.$(MACH) $(BLD)/Macros && \
#                 cd $(BLD) && ../mkSrcfiles && ../mkDepends Filepath Srcfiles > Depends && make MODEL=$(MODEL) MACHINE=$(MACH) $(MFLAGS) -r;\
#         else \
#                 rm -rf bld-* ParGRIST-GCM* partition-GCM* ; \
#         fi

        filedst     = os.path.join(bldroot, "Filepath")
        filedst_tmp = os.path.join(bldroot, "Filepath_tmp")
        if os.path.isfile(filedst):
            if not filecmp.cmp(filedst_tmp, filedst):
                shutil.move(filedst_tmp, filedst)
        else:
            shutil.move(filedst_tmp, filedst)
        #-------------------------------------------------------
        # build the library
        #-------------------------------------------------------
        complib  = os.path.join(libroot, "libatm.a")
        makefile = os.path.join(casetools, "Makefile.grist")

        cmd = "{} libatm.a -j {} MODEL=grist COMPLIB={} -f {} {} " \
            .format(gmake, gmake_j, complib, makefile, get_standard_makefile_args(case))
        # if grist_cppdefs:
        #     cmd += " USER_CPPDEFS='{}'".format(grist_cppdefs)

        logger.info(cmd)

        rc, out, err = run_cmd(cmd)
        logger.info("%s: \n\n output:\n %s \n\n err:\n\n%s\n", cmd, out, err)
        expect(rc == 0, "Command %s failed with rc=%s" % (cmd, rc))

###############################################################################

def _main_func():

    caseroot, libroot, bldroot = parse_input(sys.argv)

    _build_grist(caseroot, libroot, bldroot)

###############################################################################

if __name__ == "__main__":
    _main_func()
