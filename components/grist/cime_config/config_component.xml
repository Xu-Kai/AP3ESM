    <desc>GRIST namelist use_case.  Provides the use_case option for the
      GRIST build-namelist utility (which is called from
      $CASEROOT/Buildconf/grist.buildnml).  The GRIST build-namelist
      leverages groups of namelist options (use cases) that are often
      paired with the GRIST configure options.  These use cases are xml
      files located in
      $CIMEROOT/../components/grist/bld/namelist_files/use_cases.
      In general, this variable should not be modified for supported
      component sets (compsets).  Recommendation: If you want to
      modify this value for your experiment, use your own user-defined
      component sets.</desc>
  </entry>

  <entry id="GRIST_NAMELIST_OPTS">
    <type>char</type>
    <valid_values></valid_values>
    <default_value></default_value>
    <values match="last" modifier="additive">
      <value compset="_GRIST.*%RCO2"> scenario_ghg=&apos;RAMP_CO2_ONLY&apos;ramp_co2_annual_rate=1 </value>
      <value compset="_GRIST60%4xCO2"> co2vmr=1138.8e-6  </value>
      <value compset="_GRIST60%WCTS%4xCO2"> flbc_cycle_yr=1  </value>
      <value compset="_GRIST60%WCTS%4xCO2"> flbc_file='$DIN_LOC_ROOT/atm/waccm/lb/LBC_CMIP6abrupt4xCO2_cyclicalYear1_0p5degLat_c180929.nc'  </value>
      <value compset="_GRIST60%WCTS%4xCO2"> ncdata='$DIN_LOC_ROOT/atm/waccm/ic/b.e21.BW1850.f09_g17.CMIP6-piControl.001.cam.i.0070-01-01.abrupt4xCO2_c181003.nc'  </value>
      <value compset="_GRIST60%WCTS%4xCO2"> nlte_limit_co2=.true.  </value>
      <value compset="_GRIST60%1PCT"> flbc_type='SERIAL'</value>
      <value compset="_GRIST60%1PCT"> flbc_file='$DIN_LOC_ROOT/atm/waccm/lb/LBC_CMIP6_1pctCO2_y1-165_GlobAnnAvg_0p5degLat_c180929.nc'</value>
      <value compset="_GRIST60%1PCT"> flbc_list='CO2','CH4','N2O','CFC11eq','CFC12' </value>
      <value compset="_GRIST60%WCTS%1PCT"> flbc_type='SERIAL' </value>
      <value compset="_GRIST60%WCTS%1PCT"> flbc_cycle_yr=-1 </value>
      <value compset="_GRIST60%WCTS%1PCT"> flbc_file='$DIN_LOC_ROOT/atm/waccm/lb/LBC_CMIP6_1pctCO2ramp_y1-165_0p5degLat_c180930.nc'</value>
      <value compset="_GRIST60%WCTS%1PCT"> nlte_limit_co2=.true.</value>
      <value compset="_BGC%BDRD"> co2_cycle_rad_passive=.true. </value>
      <!-- rearth provided by FMS for FV3 and must remain fixed to that value to maintain consistency between phys/dyn. -->
      <value grid="a%C[0-9]"> rearth = 6.37122D6 </value>
    </values>
    <group>run_component_grist</group>
    <file>env_run.xml</file>
    <desc>GRIST specific namelist settings for -namelist option Provides
      options to the -namelist argument for the GRIST build-namelist
      utility.  This should be reserved for component set
      specification. Users should modify GRIST namelists only via the
      $CASEROOT/user_nl_grist file.</desc>
  </entry>

  <entry id="GRIST_USER_MODS">
    <type>char</type>
    <valid_values></valid_values>
    <default_value></default_value>
    <values match="last">
