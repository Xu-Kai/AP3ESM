    <value compset="DOCN%SOMAQP">$COMP_ROOT_DIR_ATM/cime_config/usermods_dirs/aquap</value>
    <value compset="GRIST%.*SCAM" >$COMP_ROOT_DIR_ATM/cime_config/usermods_dirs/scam_mandatory</value>
    </values>
    <group>run_component_grist</group>
    <file>env_case.xml</file>
    <desc>User mods to apply to specific compset matches. </desc>
  </entry>

