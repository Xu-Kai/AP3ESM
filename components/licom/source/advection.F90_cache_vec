              adv_xy2= (ttt(i,j,k)-ttt(i-1,j,k))*        &
                                 abs(u_wface(i,j,k))*tarea_r(i,j,iblock)
            else
            adv_xy2=dts*(ttt(i,j,k)-ttt(i-1,j,k))*2.0_r8*tarea_r(i,j,iblock)*&
                        u_wface(i,j,k)*u_wface(i,j,k)/(htw(i,j,iblock)*hun(i,j,iblock))
            endif
            if (at00(i,j,k)>atmax(i,j,k).or.at00(i,j,k)<atmin(i,j,k).or.&
                     ( j<jmt-1.and.(at00(i,j+1,k)>atmax(i,j+1,k).or.at00(i,j+1,k)<atmin(i,j+1,k))))then
              adv_xy3=-(ttt(i,j+1,k)-ttt(i,j,k))*        &
                                 abs(v_sface(i,j,k))*tarea_r(i,j,iblock)
            else
              adv_xy3=-dts*(ttt(i,j+1,k)-ttt(i,j,k))*2.0_r8*tarea_r(i,j,iblock)*&
                           v_sface(i,j,k)*v_sface(i,j,k)/(hts(i,j,iblock)*hue(i,j,iblock))

            endif
            if (at00(i,j,k)>atmax(i,j,k).or.at00(i,j,k)<atmin(i,j,k).or.&
                     (j>2.and.( at00(i,j-1,k)>atmax(i,j-1,k).or.at00(i,j-1,k)<atmin(i,j-1,k))))then

              adv_xy4= (ttt(i,j,k)-ttt(i,j-1,k))*        &
                                 abs(v_sface(i,j-1,k))*tarea_r(i,j,iblock)
            else
              adv_xy4=dts*(ttt(i,j,k)-ttt(i,j-1,k))*2.0_r8*tarea_r(i,j,iblock)*&
                      v_sface(i,j-1,k)*v_sface(i,j-1,k)/(hts(i,j-1,iblock)*hue(i,j-1,iblock))
            endif
             if(at00(i,j,k)>atmax(i,j,k).or.at00(i,j,k)<atmin(i,j,k).or. &
                 at00(i,j,k-1)>atmax(i,j,k-1).or.at00(i,j,k-1)<atmin(i,j,k-1))then
              adv_zb1=-0.5*abs(WWW(I,J,k))*ODZP(k)*(ttt(I,J,k-1)-ttt(I,J,k))
             else
            adv_zb1=-0.5*ODZP(k)*WWW(I,J,k  )*WWW(I,J,k  )*ODZT(k  ) &
                                *(ttt(I,J,k-1)-ttt(I,J,k))*dts
             end if

            adv_zb2=0.
            adv_c1=-ttt(i,j,k)*(u_wface(i+1,j,k)-u_wface(i,j,k))*tarea_r(i,j,iblock)*2.0_r8
            adv_c2=-ttt(i,j,k)*(v_sface(i,j,k)-v_sface(i,j-1,k))*tarea_r(i,j,iblock)*2.0_r8
            adv_za = 0.5*ODZP(km)*WWW(I,J,km)*(ttt(I,J,km)+ttt(I,J,km-1))
            adv_zc =    -ODZP(km)*ttt(I,J,km)*WWW(I,J,km)
            adv_x0=(ttt(i+1,j,k)+ttt(i,j,k))*u_wface(i+1,j,k)*tarea_r(i,j,iblock)&
                       -(ttt(i,j,k)+ttt(i-1,j,k))*u_wface(i,j,k)*tarea_r(i,j,iblock)
            adv_y0=((ttt(i,j+1,k)+ttt(i,j,k))*v_sface(i,j,k) &
                       -(ttt(i,j,k)+ttt(i,j-1,k))*v_sface(i,j-1,k))*tarea_r(i,j,iblock)

  !          write(13,*) adv_x0,i,j,k    


      adv_xx=-(adv_x0+adv_xy1+adv_xy2+adv_c1)
      adv_yy=-(adv_y0+adv_xy3+adv_xy4+adv_c2)
      adv_zz=-(adv_za+adv_zb1+adv_zb2+adv_zc)
      adv_tt(i,j,k)=adv_xx+adv_yy+adv_zz
       ax(i,i,k,mtracer,iblock)= adv_xx !/dble(NSS)
      ay(i,j,k,mtracer,iblock)= adv_yy !/dble(NSS)
      az(i,j,k,mtracer,iblock)= adv_zz !/dble(NSS
            END DO
